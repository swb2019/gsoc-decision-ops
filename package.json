{
  "name": "gsoc-decision-ops",
  "version": "1.0.0",
  "description": "First-hour operational decision toolkit for corporate GSOC leaders facing vendor or cyber-adjacent disruptions",
  "private": true,
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "dev": "npm run dev --workspace=apps/web",
    "build": "npm run build --workspaces",
    "build:core": "npm run build --workspace=packages/core",
    "test": "npm run test --workspace=packages/core",
    "lint": "eslint . --ext .ts,.tsx",
    "format": "prettier --write \"**/*.{ts,tsx,json,md}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,json,md}\"",
    "typecheck": "tsc -b && tsc --noEmit -p apps/web/tsconfig.json",
    "typecheck:core": "tsc -b",
    "typecheck:web": "tsc --noEmit -p apps/web/tsconfig.json",
    "prepare": "npm run build --workspace=packages/core"
  },
  "keywords": [
    "gsoc",
    "security-operations",
    "decision-making",
    "incident-response",
    "esrm",
    "vendor-management",
    "crisis-management"
  ],
  "author": "Shannon Brown",
  "license": "MIT",
  "devDependencies": {
    "@types/node": "^20.10.0",
    "@typescript-eslint/eslint-plugin": "^6.13.0",
    "@typescript-eslint/parser": "^6.13.0",
    "eslint": "^8.55.0",
    "eslint-config-prettier": "^9.1.0",
    "prettier": "^3.1.0",
    "typescript": "^5.3.2"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
